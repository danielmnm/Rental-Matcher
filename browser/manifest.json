{
  "manifest_version": 3,
  "name": "Rental Matcher",
  "version": "1.68",
  "description": "Reads Yad2 and Komo, plus Madlan pages and Facebook posts you choose, at a polite pace, and ranks rentals by your preferences. All on your computer.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Rental Matcher",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "nativeMessaging",
    "storage",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.yad2.co.il/*",
    "https://www.yad-il.co.il/*",
    "https://gw.yad2.co.il/*",
    "https://validate.perfdrive.com/*",
    "https://www.komo.co.il/*",
    "https://img.yad2.co.il/*",
    "https://images2.madlan.co.il/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.yad2.co.il/*"
      ],
      "js": [
        "yad2_pull.js",
        "sites.js",
        "runner.js",
        "store.js",
        "i18n.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.komo.co.il/code/nadlan/*",
        "https://www.madlan.co.il/for-rent/*",
        "https://www.madlan.co.il/listings/*"
      ],
      "js": [
        "sites.js",
        "i18n.js",
        "content_sites.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
